{
  "name": "outlier",
  "version": "1.0.0",
  "private": true,
  "description": "Daily trivia where the rarer your answer, the further your rocket flies. English and Hebrew; runs fully offline.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/server.ts",
    "build": "vite build",
    "start": "node server/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test tests/*.test.ts && vitest run",
    "test:server": "node --test tests/*.test.ts",
    "test:web": "vitest run",
    "e2e": "playwright test --trace off",
    "check": "npm run typecheck && npm run lint && npm test && npm run validate-bank && npm run build",
    "validate-bank": "node tools/validate-bank.ts",
    "list-prompts": "node tools/list-prompts.ts",
    "bundle": "node tools/build-bundle.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.49.1",
    "@tanstack/react-query": "^5.107.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
